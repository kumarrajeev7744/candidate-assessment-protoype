{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VideoObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::<your-private-video-bucket>/videos/*"
    },
    {
      "Sid": "ReportMissingObjectsAs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<your-private-video-bucket>",
      "Condition": { "StringLike": { "s3:prefix": ["videos/*"] } }
    }
  ]
}
