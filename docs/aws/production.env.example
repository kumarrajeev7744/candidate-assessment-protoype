# Production configuration for the API on AWS App Runner — reference only, placeholders only.
# Never commit real values. Values marked [SECRET] must be stored in AWS Secrets Manager and
# referenced from App Runner as secrets; everything else is a plain App Runner environment variable.

NODE_ENV=production
# Must match the port configured on the App Runner service
PORT=8080
# CloudFront URL of the frontend: https only, origin only (no path, no trailing slash).
# The first entry is also used for links in emails.
CLIENT_URL=https://<CLOUDFRONT_DOMAIN>
# App Runner sits behind one proxy hop; required for correct per-client rate limiting
TRUST_PROXY=1

# [SECRET] mongodb+srv://<prod-user>:<password>@<cluster-host>/<prod-database>?retryWrites=true&w=majority
MONGODB_URI=
# [SECRET] new random value, >= 32 chars (do not reuse the development secret)
JWT_SECRET=
JWT_EXPIRES_IN=1h
LOGIN_RATE_LIMIT_MAX=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<sender-gmail-address>
# [SECRET] Google App Password of SMTP_USER
SMTP_PASS=
SMTP_FROM="<Display Name> <sender-gmail-address>"
EMAIL_TIMEZONE=<IANA time zone, e.g. Asia/Kolkata>

AWS_REGION=<region of the video bucket>
S3_VIDEO_BUCKET=<VIDEO_BUCKET_NAME>
VIDEO_MAX_MB=200
VIDEO_URL_EXPIRES_IN=15m
COMPANY_NAME=

# Do NOT set in production:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  (the App Runner instance role provides credentials)
#   S3_ENDPOINT                                (local S3 emulators only)
#   ADMIN_EMAIL / ADMIN_PASSWORD               (only needed while running seed:admin from your machine)

# Frontend (build-time, not a secret; passed when running `npm run build:client`):
#   VITE_API_BASE_URL=https://<APP_RUNNER_SERVICE_DOMAIN>/api
