# Every environment variable the API server reads. Copy to server/.env for LOCAL DEVELOPMENT
# (never commit it). The Docker image never contains a .env file: on AWS ECS, plain values are
# task-definition environment variables and values marked [SECRET] come from AWS Secrets Manager.
#
# [REQUIRED] = the API refuses to start without it (seed scripts only need MONGODB_URI + ADMIN_*).
# [SECRET]   = store in Secrets Manager in AWS; never in git, logs, tickets or chat.

# --- Server ---
# Port the API listens on (on 0.0.0.0). The Docker image sets 4000.
PORT=4000
# development | test | production (the Docker image sets production)
NODE_ENV=development
# [REQUIRED] Allowed frontend origin(s) for CORS, comma-separated, origin only (no path).
# The first entry is also the base URL for links in emails. Production: https://<CloudFront domain>.
# (The older name CLIENT_URL is still accepted as a fallback.)
FRONTEND_URL=http://localhost:5173
# Proxy hops to trust for client IPs. Default: 1 in production (behind the ALB), 0 otherwise.
# TRUST_PROXY=

# --- Database ---
# [REQUIRED] [SECRET] MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/candidate_assessment?retryWrites=true&w=majority

# --- Recruiter authentication ---
# [REQUIRED] [SECRET] Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# Token lifetime: seconds or a number with s/m/h/d (default 1h)
JWT_EXPIRES_IN=1h
# Failed login attempts allowed per client IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
# Admin account created by `npm run seed:admin` / `seed:admin:prod` ONLY. Not read by the running API;
# do not set these on the ECS service. [SECRET] for ADMIN_PASSWORD (min 12 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password-min-12-chars>

# --- Email (Gmail SMTP via Google App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only when using port 465 (587 uses STARTTLS)
SMTP_SECURE=false
# [REQUIRED] Full Gmail address that owns the App Password
SMTP_USER=<your-gmail-address@gmail.com>
# [REQUIRED] [SECRET] 16-character Google App Password (spaces are ignored)
SMTP_PASS=<google-app-password>
# Sender shown to recipients; must be the Gmail account or a verified alias
SMTP_FROM="Candidate Assessment <your-gmail-address@gmail.com>"
# Time zone for dates shown in emails (IANA name, e.g. Asia/Kolkata)
EMAIL_TIMEZONE=UTC

# --- Video storage (Amazon S3, private bucket) ---
# [REQUIRED] Region of the video bucket
AWS_REGION=ap-south-1
# [REQUIRED] Private video bucket name
S3_VIDEO_BUCKET=<your-private-video-bucket>
# LOCAL DEVELOPMENT ONLY [SECRET]. Never set these on ECS: the task role provides credentials through
# the AWS SDK default credential chain. (Locally you can use AWS_PROFILE instead.)
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
# Optional S3-compatible endpoint for a local emulator (MinIO/LocalStack). Leave unset for AWS.
# S3_ENDPOINT=
# Maximum video size in MB and presigned URL lifetime
VIDEO_MAX_MB=200
VIDEO_URL_EXPIRES_IN=15m

# --- Branding (optional) ---
# Employer name used in the submission confirmation email. Leave empty to omit it.
COMPANY_NAME=
