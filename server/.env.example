# LOCAL DEVELOPMENT configuration. Copy to server/.env (never commit it).
# Production values are documented in docs/aws/production.env.example; on AWS, secrets come from
# AWS Secrets Manager and nothing is read from a .env file.

# Port the API listens on
PORT=4000
# development | test | production
NODE_ENV=development
# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string (keep the real value out of git)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/candidate_assessment?retryWrites=true&w=majority

# --- Admin authentication ---
# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# Token lifetime: seconds or a number with s/m/h/d (default 1h)
JWT_EXPIRES_IN=1h
# Seeded admin account (read only by `npm run seed:admin`; not needed by the running API)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password-min-12-chars>
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
# Proxy hops to trust for client IPs (0 locally; 1 behind AWS App Runner)
TRUST_PROXY=0

# --- Email (Gmail SMTP via Google App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only when using port 465
SMTP_SECURE=false
# Full Gmail address that owns the App Password
SMTP_USER=<your-gmail-address@gmail.com>
# 16-character Google App Password (spaces are ignored)
SMTP_PASS=<google-app-password>
# Sender shown to recipients; must be the Gmail account or a verified alias
SMTP_FROM="Candidate Assessment <your-gmail-address@gmail.com>"
# Time zone for dates shown in emails (IANA name)
EMAIL_TIMEZONE=UTC

# --- Video storage (Amazon S3, private bucket) ---
AWS_REGION=ap-south-1
S3_VIDEO_BUCKET=<your-private-video-bucket>
# LOCAL DEVELOPMENT ONLY. Never set these on App Runner: the IAM instance role provides credentials.
# (Alternatively leave these out and set AWS_PROFILE to use ~/.aws/credentials.)
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
# Maximum video size in MB and presigned URL lifetime
VIDEO_MAX_MB=200
VIDEO_URL_EXPIRES_IN=15m

# --- Branding (optional) ---
# Employer name used in the submission confirmation email. Leave empty to omit it.
COMPANY_NAME=
