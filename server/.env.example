# Port the API listens on
PORT=4000
# development | test | production
NODE_ENV=development
# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string (keep the real value out of git)
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/candidate_assessment?retryWrites=true&w=majority

# --- Admin authentication ---
# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# Token lifetime: seconds or a number with s/m/h/d (default 1h)
JWT_EXPIRES_IN=1h
# Seeded admin account (used only by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password-min-12-chars>
# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10
# Proxy hops to trust for client IPs (set to 1 behind AWS App Runner)
TRUST_PROXY=0
