# Base URL of the backend REST API (baked into the bundle at build time; never put secrets in VITE_* variables).
# Local development:
VITE_API_BASE_URL=http://localhost:4000/api
# Production builds must set the public HTTPS API URL instead, e.g.
#   VITE_API_BASE_URL=https://<APP_RUNNER_SERVICE_DOMAIN>/api npm run build:client
# A production build fails if this variable is missing.
